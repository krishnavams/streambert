<?xml version="1.0" encoding="UTF-8"?>
<!-- Tizen web app manifest for Samsung TVs. The version is filled in from package.json by the build. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://github.com/truelockmc/streambert/tv" version="__VERSION__" viewmodes="maximized">
    <tizen:application id="StrmBrtTV0.Streambert" package="StrmBrtTV0" required_version="4.0"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <icon src="icon.png"/>
    <name>Streambert</name>
    <description>Stream movies, TV series and anime.</description>
    <!-- lets the app call TMDB, AniList and HiAnime without CORS restrictions -->
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <!-- Without this Tizen applies "script-src 'self'; style-src 'self'; default-src *",
         which blocks blob: video (hls.js / MSE), data: images and inline style changes. -->
    <tizen:content-security-policy>default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src * data: blob:; media-src * data: blob:; font-src 'self' data:; connect-src *; frame-src *; child-src * blob:; worker-src 'self' blob:</tizen:content-security-policy>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
