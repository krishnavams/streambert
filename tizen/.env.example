# Copy to tizen/.env and fill in before `npm run tv:build` / `npm run tv:package`.
# The TMDB API Read Access Token (the long "eyJ..." one, not the short API key).
# Baking it in saves typing ~200 characters with the TV remote on first launch.
# Never commit tizen/.env (it is gitignored).
VITE_TMDB_TOKEN=
